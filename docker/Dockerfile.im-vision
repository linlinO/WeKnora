ARG BUILDER_IMAGE=weknora-app-builder:feedback-names-20260923
ARG RUNTIME_IMAGE=weknora-app:feedback-names-20260923
FROM ${BUILDER_IMAGE} AS builder
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod go test ./internal/types ./internal/im ./internal/im/wecom ./internal/application/service/chat_pipeline ./internal/application/service -count=1
RUN --mount=type=cache,target=/go/pkg/mod make build-prod
FROM ${RUNTIME_IMAGE}
COPY --from=builder --chown=appuser:appuser /app/WeKnora /app/WeKnora
COPY --chown=appuser:appuser migrations /app/migrations
COPY --chown=appuser:appuser config/builtin_agents.yaml /app/config/builtin_agents.yaml
